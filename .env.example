# ============================================================
# Wrath of Midnight Raid Bot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control!

# ----------------------------------------------------------
# REQUIRED - Bot will not start without these
# ----------------------------------------------------------

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord server (guild) ID
# Right-click your server name > Copy Server ID (requires Developer Mode)
GUILD_ID=your_guild_id_here

# ----------------------------------------------------------
# OPTIONAL - Defaults are set but can be customized
# ----------------------------------------------------------

# The channel ID where raid events will be posted by default
# Right-click the channel > Copy Channel ID
EVENT_CHANNEL_ID=your_event_channel_id_here

# Attendance percentage below which members receive warnings (default: 75)
ATTENDANCE_WARNING_THRESHOLD=75

# Server timezone for event display (default: America/New_York)
# See full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# Channel ID for bot log/audit messages (optional)
LOG_CHANNEL_ID=

# Prefix for legacy text commands (default: !)
COMMAND_PREFIX=!

# Database file path (default: ./data/raidbot.db)
DATABASE_PATH=./data/raidbot.db

# ----------------------------------------------------------
# OPTIONAL - Blizzard Battle.net API (enables Armory lookup)
# ----------------------------------------------------------
# Create an app at https://develop.battle.net/access/clients
# Enables /character add realm:<realm> to auto-fill class/spec/ilvl
# and /character sync to refresh a character from the Armory.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
