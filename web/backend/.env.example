# Discord OAuth2 — create/reuse application at https://discord.com/developers/applications
# Under OAuth2 → General, add a redirect URI matching DISCORD_REDIRECT_URI below
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://raids.yourwowguild.com/auth/callback

# The Discord server (guild) ID members must belong to in order to log in
ALLOWED_GUILD_ID=your_guild_discord_id

# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_random_secret

# Shared SQLite database — relative path from web/backend/ to the bot's database
DATABASE_PATH=../../data/raidbot.db

# API server binding (127.0.0.1 keeps it local; Nginx proxies /api to this port)
API_HOST=127.0.0.1
API_PORT=8001

# Comma-separated allowed CORS origins (your web front-end URL)
CORS_ORIGINS=https://raids.yourwowguild.com,http://localhost:5173
